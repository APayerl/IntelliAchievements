<idea-plugin>
	<id>eu.andret.intelliachievements.v1</id>
	<name>IntelliAchievements</name>
	<vendor email="andret2344@gmail.com">Andret2344</vendor>

	<description><![CDATA[
		This plugin adds some fun during coding.
		Allows you to get and check achievements for writing and running your Java programs, or using your IDE User Interface.
		]]></description>

	<change-notes><![CDATA[
		<ul>
			<li><b>v0.3</b> - removed deprecation from plugin.
			<li><b>v0.2.1</b> - fixed achievements that weren't working
			<li><b>v0.2</b> - fixed crash on startup and added more achievements
			<li><b>v0.1</b> - initial release, contains 2 levelable achievements
		</ul>
		]]>
	</change-notes>

	<!-- http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/build_number_ranges.html -->
	<!-- http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html -->
	<depends>com.intellij.modules.lang</depends>

	<extensions defaultExtensionNs="com.intellij">
		<typedHandler implementation="eu.andret.intelliachievements.MyTypedHandlerDelegate"/>
		<applicationConfigurable instance="eu.andret.intelliachievements.PluginConfigurable"/>
		<consoleFilterProvider implementation="eu.andret.intelliachievements.MyConsoleFilter"/>
		<notificationGroup id="Achievements" displayType="BALLOON"/>
	</extensions>

	<application-components>
		<component>
			<implementation-class>eu.andret.intelliachievements.IntelliAchievements
			</implementation-class>
		</component>
	</application-components>

	<actions>
		<action
				id="eu.andret.intelliachievements.achievements.EggFound"
				class="eu.andret.intelliachievements.achievements.EggFound"
				text="Easter Egg"
		>
			<add-to-group group-id="AnalyzePlatformMenu" anchor="last"/>
		</action>
	</actions>
</idea-plugin>
